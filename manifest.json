{
  "manifest_version": 3,
  "name": "Data Entry Pro - Claims Automation",
  "version": "1.2.7",
  "description": "Enterprise-grade UI automation for medical review and claims evaluation portals with zero-click auto-reload and 4-tier approval engine.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Data Entry Pro v1.2.7",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["reload_signal.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "trigger_automation": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Run Data Entry Pro (Full 4-Tier Approval)"
    }
  }
}
